apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: nodepool-default
spec:
  template:
    spec:
      nodeClassRef:
        group: karpenter.sagemaker.amazonaws.com
        kind: HyperpodNodeClass
        name: nodeclass-default
      expireAfter: Never
      requirements:
        - key: "node.kubernetes.io/instance-type"
          operator: Exists
  # The most CPUs Karpenter may add in total
  limits:
    cpu: "${AUTOSCALE_CPU_LIMIT}"
