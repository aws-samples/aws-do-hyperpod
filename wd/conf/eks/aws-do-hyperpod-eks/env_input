# Input environemnt variables

## HyperPod
export CREATE_EKS_CLUSTER=true
export CREATE_SUBNET=false
export RESOURCE_NAME_PREFIX=aws-do-hyperpod-eks
export EKS_CLUSTER_NAME=${RESOURCE_NAME_PREFIX}-cluster
export HYPERPOD_NAME=${RESOURCE_NAME_PREFIX}-smhp
export STACK_ID=${RESOURCE_NAME_PREFIX}-cfn
#export ACCEL_INSTANCE_TYPE=ml.g5.2xlarge
export ACCEL_INSTANCE_TYPE=ml.m5.xlarge
export ACCEL_COUNT=1
export ACCEL_VOLUME_SIZE=500
export GEN_INSTANCE_TYPE=ml.c5.2xlarge
export GEN_COUNT=1
export GEN_VOLUME_SIZE=300
#export ONSTART_DEEP_HEALTHCHECKS="[\"InstanceStress\", \"InstanceConnectivity\"]"
export NODE_RECOVERY=Automatic

# Autoscaling with Karpenter (optional), set when the cluster is created or updated.
## ENABLE_AUTOSCALING=false(default): the cluster is created with the ACCEL_COUNT and GEN_COUNT instances above.
##   An update does not change autoscaling on the cluster.
## ENABLE_AUTOSCALING=true: on create, ACCEL_COUNT and GEN_COUNT are ignored and both instance groups start with 0 instances.
##   On update, autoscaling is enabled if the cluster does not have it yet. The instance counts are sent as configured.
## Create the HyperpodNodeClass and NodePool after the cluster is up, see impl/eks/src/manifests/autoscaling/
export ENABLE_AUTOSCALING=true
# VPC
export AVAILABILITY_ZONE_ID=use1-az4
export VPC_CIDR=10.192.0.0/16
export PUBLIC_SUBNET1_CIDR=10.192.10.0/24
export PUBLIC_SUBNET2_CIDR=10.192.11.0/24
export PUBLIC_SUBNET3_CIDR=10.192.12.0/24
export PRIVATE_SUBNET1_CIDR=10.1.0.0/16
